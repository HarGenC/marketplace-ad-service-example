# Локальный запуск: сервисы в docker-compose проброшены на хост.
# Дефолты в src/settings.py рассчитаны на docker-сеть marketplace,
# поэтому без этого файла make migrate / make run не найдут PostgreSQL.

POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DATABASE_NAME=ads_db
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres

# 8000 занят auth-service
API_HOST=127.0.0.1
API_PORT=8002

# Должен совпадать с JWT_SECRET в auth-service, иначе ad ответит 401
JWT_SECRET=change-me
JWT_ALGORITHM=HS256

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_ADS=ads

AUTH_SERVICE_URL=http://localhost:8000

LOG_LEVEL=INFO
